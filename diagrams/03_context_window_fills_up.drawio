<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.7.9">
  <diagram name="3 - Context window fills up">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="3. The accumulation problem: tokens grow every turn until you hit the wall" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f3b73;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Because every turn re-sends every previous message, the prompt size grows linearly with conversation length. Three things go up: cost, latency, and the risk of crashing into the context window." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1520" height="36" as="geometry" />
        </mxCell>

        <mxCell id="walllbl" value="&lt;b&gt;Context window limit&lt;/b&gt;   (example values: GPT-4 Turbo = 128,000 tokens.   Claude = 200,000.   Gemini = 1,000,000.)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="118" width="1100" height="22" as="geometry" />
        </mxCell>
        <mxCell id="wall" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=3;dashed=1;dashPattern=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="155" as="sourcePoint" />
            <mxPoint x="1180" y="155" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="walltag" value="HARD CEILING - any request whose total tokens cross this line is rejected by the API" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="walltagY" value="128k" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="146" width="50" height="20" as="geometry" />
        </mxCell>

        <mxCell id="bar1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5d8a47;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="673" width="160" height="27" as="geometry" />
        </mxCell>
