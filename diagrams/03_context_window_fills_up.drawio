          <mxGeometry x="100" y="649" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bar1lbl" value="&lt;b&gt;Turn 1&lt;/b&gt;&#xa;~500 tokens" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="100" y="715" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="bar2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#5d8a47;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="634" width="160" height="66" as="geometry" />
        </mxCell>
        <mxCell id="bar2cost" value="cost: $0.001" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="610" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bar2lbl" value="&lt;b&gt;Turn 5&lt;/b&gt;&#xa;~4,000 tokens" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="320" y="715" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="bar3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#a08938;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="562" width="160" height="138" as="geometry" />
        </mxCell>
        <mxCell id="bar3cost" value="cost: $0.006&#xa;quality: still fine" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="528" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bar3lbl" value="&lt;b&gt;Turn 20&lt;/b&gt;&#xa;~25,000 tokens" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="540" y="715" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="bar4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a06a00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="315" width="160" height="385" as="geometry" />
        </mxCell>
        <mxCell id="bar4cost" value="cost: $0.022&#xa;quality: lost-in-the-middle risk rising" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="740" y="280" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bar4lbl" value="&lt;b&gt;Turn 60&lt;/b&gt;&#xa;~90,000 tokens" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="760" y="715" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="bar5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#8a3e3a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="160" width="160" height="540" as="geometry" />
        </mxCell>
        <mxCell id="bar5cost" value="API ERROR&#xa;context_length_exceeded" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="190" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bar5cost2" value="bundle hits the wall;&#xa;you cannot send this request" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="980" y="240" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bar5lbl" value="&lt;b&gt;Turn 80&lt;/b&gt;&#xa;~128,000 tokens" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="980" y="715" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="baseline" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="700" as="sourcePoint" />
            <mxPoint x="1180" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="basetag" value="0 tokens" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="690" width="50" height="20" as="geometry" />
        </mxCell>

        <mxCell id="cons" value="&lt;b&gt;Three things grow with each turn&lt;/b&gt;&#xa;&#xa;&lt;b&gt;1) Cost.&lt;/b&gt;  Most providers price by input tokens. Re-sending Turn 1&#x2019;s message at Turn 80 means you pay for it 80 times.&#xa;&#xa;&lt;b&gt;2) Latency.&lt;/b&gt;  Longer prompts = longer time-to-first-token. A 100k-token prompt can add 5-15 seconds before any answer starts.&#xa;&#xa;&lt;b&gt;3) Quality risk.&lt;/b&gt;  Even when you stay under the wall, models tend to forget content stuck in the middle of very long prompts. This is the &quot;lost in the middle&quot; effect: relevant info gets diluted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1220" y="200" width="340" height="500" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="&lt;b&gt;The takeaway.&lt;/b&gt;  Naive append-everything chat works fine for short conversations and breaks for long ones. Long-running assistants need a strategy for keeping the message list bounded. That is what diagram 4 is about: clearing, summarizing, hybrid windows, and retrieval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1520" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
