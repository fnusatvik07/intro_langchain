        <mxCell id="pb_a3" value="a3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1130" y="240" width="50" height="32" as="geometry" /></mxCell>
