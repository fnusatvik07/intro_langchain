          <mxGeometry x="840" y="370" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pb2_sum" value="&#x3A3; summary of u1..a5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="840" y="394" width="220" height="32" as="geometry" /></mxCell>
        <mxCell id="pb2_u6" value="u6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1068" y="394" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pbprocon" value="&lt;b&gt;Pro:&lt;/b&gt;  keeps the gist of arbitrarily long history. Token use stays roughly flat after the first compression.&#xa;&lt;b&gt;Con:&lt;/b&gt;  lossy. Specific numbers, names, or quoted text can disappear in the summary. Costs an extra LLM call (and gets re-summarized as the conversation grows further)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="445" width="700" height="170" as="geometry" />
        </mxCell>

        <mxCell id="pc" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafbff;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="740" height="490" as="geometry" />
        </mxCell>
        <mxCell id="pctitle" value="C. Hybrid: summary + recent N    &lt;font color=&quot;#82b366&quot;&gt;[most common in production]&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1f3b73;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pctag" value="Summarize anything older than the last K turns. Keep the recent K verbatim. Trigger on a token threshold." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="698" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pclbl" value="Before:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="60" y="726" width="700" height="20" as="geometry" />
        </mxCell>
