        <mxCell id="pb_u6" value="u6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="240" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pbcompress" value="compress these &#x2192;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="278" width="572" height="18" as="geometry" /></mxCell>
        <mxCell id="pbcall" value="extra LLM call:&#xa;&quot;Summarize this conversation in 4 lines, preserving names, decisions, and unresolved threads.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="306" width="630" height="50" as="geometry" />
        </mxCell>
