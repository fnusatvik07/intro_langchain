        <mxCell id="pc_a2" value="a2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="234" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_u3" value="u3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="292" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_a3" value="a3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_u4" value="u4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="408" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_a4" value="a4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="466" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_u5" value="u5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="524" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_a5" value="a5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="582" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc_u6" value="u6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="750" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pccmprss" value="compress" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="788" width="282" height="18" as="geometry" /></mxCell>
        <mxCell id="pckeep" value="kept verbatim (last 5)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f3b73;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="408" y="788" width="282" height="18" as="geometry" /></mxCell>
        <mxCell id="pcalbl" value="Sent to LLM next turn:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pc2_sum" value="&#x3A3; summary of u1..a3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="844" width="200" height="32" as="geometry" /></mxCell>
        <mxCell id="pc2_u4" value="u4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="268" y="844" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc2_a4" value="a4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="326" y="844" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc2_u5" value="u5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="384" y="844" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc2_a5" value="a5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="442" y="844" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pc2_u6" value="u6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="844" width="50" height="32" as="geometry" /></mxCell>
        <mxCell id="pcprocon" value="&lt;b&gt;Pro:&lt;/b&gt;  best of both worlds. The summary holds long-term context, recent verbatim turns preserve the precise wording the user just used (which they often refer to with words like &quot;that&quot; or &quot;it&quot;).&#xa;&lt;b&gt;Con:&lt;/b&gt;  you tune two knobs: when to trigger compression (token threshold) and how many recent turns to keep verbatim (K). LangChain helpers: trim_messages, ConversationSummaryBufferMemory, LangGraph checkpointer with summary node." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="700" height="230" as="geometry" />
        </mxCell>

        <mxCell id="pd" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafbff;strokeColor=#a6b0c2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="660" width="740" height="490" as="geometry" />
        </mxCell>
        <mxCell id="pdtitle" value="D. Vector retrieval (semantic memory)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1f3b73;" vertex="1" parent="1">
          <mxGeometry x="840" y="670" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pdtag" value="Store every past message in a vector DB. Each turn, retrieve only the messages most relevant to the new query." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="698" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pdstore" value="&lt;b&gt;Vector store&lt;/b&gt;&#xa;u1, a1, u2, a2, u3, a3, u4, a4, u5, a5  (all embedded)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="730" width="320" height="80" as="geometry" />
        </mxCell>
