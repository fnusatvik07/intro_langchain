        <mxCell id="pc_a1" value="a1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="118" y="750" width="50" height="32" as="geometry" /></mxCell>
