          <mxGeometry x="840" y="160" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pbtag" value="Run the old messages through a separate LLM call. Replace them with one summary." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
